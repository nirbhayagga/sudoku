# Copy to .env for Traefik or registry deployments; see docs/deployment.md.

# Hostname Traefik routes to this app.
SUDOKU_HOST=sudoku.example.com

# Owner of the published images, for docker-compose.registry.yml.
SUDOKU_OWNER=nirbhayagga

# Image tag: latest tracks main; use a version or sha-<full-commit-sha> to pin.
SUDOKU_TAG=latest

# Leave empty for same-origin API access; set an exact frontend origin for a remote API.
CORS_ORIGIN=
