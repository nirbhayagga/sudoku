# Copy to .env and adjust. Referenced by the docker-compose files, which keep no
# site-specific values so the repository can be published as-is.

# Hostname Traefik routes to this app.
SUDOKU_HOST=sudoku.example.com

# Owner of the published images, for docker-compose.registry.yml.
SUDOKU_OWNER=nirb

# Image tag to run: latest, or a commit SHA to pin a rollback.
SUDOKU_TAG=latest
