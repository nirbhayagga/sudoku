{
  "name": "sudoku",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Browser-based sudoku solver and player",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run test && npm run build:all",
    "build:standalone": "vite build --mode standalone",
    "build:all": "npm run build && npm run build:standalone",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "vite": "^8.2.1",
    "vitest": "^3.0.0"
  }
}
